{
  "nx_schema": 1,
  "version": "gls-hu-depots-v1",
  "output_type": "facility",
  "table_selector": {"index": 0},
  "skip_rows": 0,
  "columns": [
    {"source": 0, "target": "name", "type": "string", "transforms": ["trim"], "required": true},
    {"source": 1, "target": "address", "type": "string", "transforms": ["trim"], "required": true},
    {"source": 2, "target": "lat", "type": "double", "precision": 6, "required": true,
     "transforms": [{"replace": ["~", ""]}],
     "validate": {"min": -90.0, "max": 90.0}},
    {"source": 3, "target": "lon", "type": "double", "precision": 6, "required": true,
     "transforms": [{"replace": ["~", ""]}],
     "validate": {"min": -180.0, "max": 180.0}}
  ],
  "derived": [
    {"target": "facility_type", "value": "depot"},
    {"target": "operator", "value": "GLS"},
    {"target": "country", "value": "HU"}
  ],
  "row_id": {"template": "gls-hu-depot-{name}", "slugify": true}
}
