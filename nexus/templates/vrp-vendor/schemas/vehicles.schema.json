    {"source": 2, "target": "depot",             "type": "string", "transforms": ["trim"], "default": ""},
    {"source": 3, "target": "capacity_pallets",  "type": "double", "precision": 10, "validate": {"min": 0}},
    {"source": 4, "target": "capacity_kg",       "type": "double", "precision": 10, "validate": {"min": 0}},
    {"source": 5, "target": "operator",          "type": "string", "transforms": ["trim"], "default": ""}
