{
  "nx_schema": 2,
  "version": "TEMPLATE-orders-v1",
  "output_type": "record",
  "skip_rows": 0,

  "_comment": "SKELETON. Set every `source` to the 0-based raw column index for THIS vendor's export, and adjust the address merge / time-window regex to match. Delete fields the vendor lacks; add any extra columns you want carried through. Canonical targets the pipeline uses are kept below.",

  "multi_transforms": [
    {"_comment": "Build the string that gets geocoded. Reorder/retemplate to fit the raw address columns (here: street, city, zip).",
     "type": "merge", "sources": [3, 2, 1], "template": "{0}, {2} {1}",
     "target": "address_geocode"},

    {"_comment": "Split a 'HH:MM - HH:MM' delivery window into tw_start/tw_end. Drop this block if the vendor has no windows.",
     "type": "regex", "source": 8,
     "pattern": "([0-9]{1,2}:[0-9]{2}) *- *([0-9]{1,2}:[0-9]{2})",
     "targets": [
       {"field": "tw_start", "group": 1},
       {"field": "tw_end", "group": 2}
     ]}
  ],

  "columns": [
    {"source": 0,  "target": "order_no",        "type": "string", "transforms": ["trim"], "required": true},
    {"source": 1,  "target": "zip",             "type": "string", "transforms": ["trim"], "default": ""},
    {"source": 2,  "target": "city",            "type": "string", "transforms": ["trim"], "required": true},
    {"source": 3,  "target": "street",          "type": "string", "transforms": ["trim"], "default": ""},
    {"source": 4,  "target": "customer",        "type": "string", "transforms": ["trim"], "default": ""},
    {"source": 5,  "target": "ship_addr_id",    "type": "string", "transforms": ["trim"], "default": ""},
    {"source": 6,  "target": "weight_kg",       "type": "double", "precision": 10, "validate": {"min": 0}},
    {"source": 7,  "target": "pallets",         "type": "double", "precision": 10, "validate": {"min": 0}},
    {"source": 9,  "target": "service_min",     "type": "int",    "default": "0", "validate": {"min": 0}},
    {"source": 10, "target": "delivery_date",   "type": "string", "transforms": ["trim"], "default": ""},

    {"_comment": "virtual columns produced by multi_transforms above; keep as-is",
     "source": 11, "target": "address_geocode", "type": "string", "default": ""},
    {"source": 12, "target": "tw_start",        "type": "string", "default": ""},
    {"source": 13, "target": "tw_end",          "type": "string", "default": ""}
  ],

  "row_id": {"_comment": "MUST be stable and unique per order-line (the matrix bijection key). If order_no can repeat, add another distinguishing field.",
             "template": "TEMPLATE-{order_no}", "slugify": true},

  "validate": [
    {"_comment": "Set to the vendor's country bounding box so bad geocodes are flagged.",
     "type": "geo_bounds", "lat_field": "lat", "lon_field": "lon",
     "bounds": {"min_lat": -90, "max_lat": 90, "min_lon": -180, "max_lon": 180},
     "severity": "warning"}
  ]
}
