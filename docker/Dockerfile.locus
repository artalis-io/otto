# Locus Geocoder
#
# Build:
#   docker build -f docker/Dockerfile.locus -t otto-locus .
#
# Run:
#   docker run -p 8083:8083 -v $(pwd)/data:/data:ro otto-locus /data/map.osm.pbf
#
# With pre-built index:
#   docker run -p 8083:8083 -v $(pwd)/data:/data:ro otto-locus -i /data/map.lcx
#
# Security:
#   - Distroless base (no shell, no package manager)
#   - Non-root user (uid 65532)
#   - Read-only root filesystem supported
#
# See docs/internals/security-model.md for security architecture.

# =============================================================================
# Build stage
# =============================================================================
FROM debian:bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY locus/ locus/
COPY shared/ shared/
COPY vendor/ vendor/
COPY Makefile .

RUN make shared && make locus && make locus-api

# Verify the binary works
RUN ./locus/api/locus-geocoder --help || true

FROM busybox:1.36.1-musl AS healthcheck

# =============================================================================
# Runtime stage (distroless)
# =============================================================================
FROM gcr.io/distroless/cc-debian12:nonroot

LABEL org.opencontainers.image.title="OTTO Locus Geocoder"
LABEL org.opencontainers.image.description="OSM geocoding with forward search, autocomplete, and reverse lookup"
LABEL org.opencontainers.image.source="https://github.com/ottofleet/otto"
LABEL org.opencontainers.image.documentation="https://github.com/ottofleet/otto/blob/main/locus/CLAUDE.md"

WORKDIR /app

COPY --from=builder --chown=nonroot:nonroot /build/locus/api/locus-geocoder /app/locus-geocoder
COPY --from=healthcheck /bin/busybox /app/healthcheck

EXPOSE 8083

USER nonroot

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD ["/app/healthcheck", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8083/api/v1/health"]

ENTRYPOINT ["/app/locus-geocoder", "-p", "8083"]
CMD ["/data/map.osm.pbf"]
