# Carta Tile Server
#
# Build:
#   docker build -f docker/Dockerfile.carta -t otto-carta .
#
# Run:
#   docker run -p 8081:8081 -v $(pwd)/data:/data:ro otto-carta /data/map.osm.pbf
#
# Security:
#   - Distroless base (no shell, no package manager)
#   - Non-root user (uid 65532)
#   - Read-only root filesystem supported
#
# See docs/internals/security-model.md for security architecture.

# =============================================================================
# Build stage
# =============================================================================
FROM debian:bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY carta/ carta/
COPY shared/ shared/
COPY vendor/ vendor/
COPY Makefile .

RUN make shared && make carta && make carta-api

# Verify the binary works
RUN ./carta/api/carta-tile-server --help || true

# =============================================================================
# Runtime stage (distroless)
# =============================================================================
FROM gcr.io/distroless/cc-debian12:nonroot

# Labels
LABEL org.opencontainers.image.title="OTTO Carta Tile Server"
LABEL org.opencontainers.image.description="OSM vector and raster tile generator"
LABEL org.opencontainers.image.source="https://github.com/ottofleet/otto"
LABEL org.opencontainers.image.documentation="https://github.com/ottofleet/otto/blob/main/carta/CLAUDE.md"

WORKDIR /app

# Copy binary (owned by nonroot user)
COPY --from=builder --chown=nonroot:nonroot /build/carta/api/carta-tile-server /app/carta-tile-server
COPY --from=builder --chown=nonroot:nonroot /build/carta/api/static /app/static

# Data directory (mount point)
# Note: distroless doesn't have mkdir, directory created by volume mount

EXPOSE 8081

# Distroless uses nonroot user by default (uid 65532)
USER nonroot

# Health check not available in distroless (no curl/wget)
# Use orchestrator health checks instead (Kubernetes, Docker Compose)

ENTRYPOINT ["/app/carta-tile-server", "-p", "8081", "-s", "/app/static"]
CMD ["/data/map.osm.pbf"]
