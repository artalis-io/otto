# Ralph LP/MIP Solver
#
# Build:
#   docker build -f docker/Dockerfile.ralph -t otto-ralph .
#
# Run:
#   docker run -p 8084:8084 otto-ralph
#
# Security:
#   - Distroless base (no shell, no package manager)
#   - Non-root user (uid 65532)
#   - Read-only root filesystem supported
#   - No filesystem access needed (problems via API)
#
# See docs/internals/security-model.md for security architecture.

# =============================================================================
# Build stage
# =============================================================================
FROM debian:bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY ralph/ ralph/
COPY shared/ shared/
COPY vendor/ vendor/
COPY Makefile .

RUN make shared && make ralph && make ralph-api

# Verify the binary works
RUN ./ralph/api/ralph-solver-server --help || true

# =============================================================================
# Runtime stage (distroless)
# =============================================================================
FROM gcr.io/distroless/cc-debian12:nonroot

LABEL org.opencontainers.image.title="OTTO Ralph Solver"
LABEL org.opencontainers.image.description="LP/MIP solver with Revised Simplex, Branch & Bound, Gomory cuts"
LABEL org.opencontainers.image.source="https://github.com/ottofleet/otto"
LABEL org.opencontainers.image.documentation="https://github.com/ottofleet/otto/blob/main/ralph/CLAUDE.md"

WORKDIR /app

COPY --from=builder --chown=nonroot:nonroot /build/ralph/api/ralph-solver-server /app/ralph-solver

EXPOSE 8084

USER nonroot

ENTRYPOINT ["/app/ralph-solver", "-p", "8084"]
