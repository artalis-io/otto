# FuelWise Refueling Optimizer
#
# Build:
#   docker build -f docker/Dockerfile.fuelwise -t otto-fuelwise .
#
# Run:
#   docker run -p 8080:8080 otto-fuelwise
#
# Security:
#   - Distroless base (no shell, no package manager)
#   - Non-root user (uid 65532)
#   - Read-only root filesystem supported
#   - No filesystem access needed (data via API)
#
# See docs/internals/security-model.md for security architecture.

# =============================================================================
# Build stage
# =============================================================================
FROM debian:bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY ralph/ ralph/
COPY fuelwise/ fuelwise/
COPY shared/ shared/
COPY vendor/ vendor/
COPY Makefile .

RUN make shared && make ralph && make fuelwise && make fuelwise-api

# Run tests
RUN make test-ralph && make test-fuelwise

# Verify the binary works
RUN ./fuelwise/api/fuelwise-api --help || true

# =============================================================================
# Runtime stage (distroless)
# =============================================================================
FROM gcr.io/distroless/cc-debian12:nonroot

LABEL org.opencontainers.image.title="OTTO FuelWise API"
LABEL org.opencontainers.image.description="Truck refueling optimization via LP formulation"
LABEL org.opencontainers.image.source="https://github.com/ottofleet/otto"
LABEL org.opencontainers.image.documentation="https://github.com/ottofleet/otto/blob/main/fuelwise/CLAUDE.md"

WORKDIR /app

COPY --from=builder --chown=nonroot:nonroot /build/fuelwise/api/fuelwise-api /app/fuelwise-api

EXPOSE 8080

USER nonroot

ENTRYPOINT ["/app/fuelwise-api", "-p", "8080"]
