# Velo Route Server
#
# Build:
#   docker build -f docker/Dockerfile.velo -t otto-velo .
#
# Run:
#   docker run -p 8082:8082 -v $(pwd)/data:/data:ro otto-velo /data/map.osm.pbf
#
# Security:
#   - Distroless base (no shell, no package manager)
#   - Non-root user (uid 65532)
#   - Read-only root filesystem supported
#
# See docs/internals/security-model.md for security architecture.

# =============================================================================
# Build stage
# =============================================================================
FROM debian:bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY velo/ velo/
COPY shared/ shared/
COPY vendor/ vendor/
COPY Makefile .

# velo-api builds libvelo itself with NOMP=1 (see velo/api/Makefile); a plain
# `make velo` here yields the OpenMP variant and the api link then fails on GOMP_*.
RUN make shared && make velo-api

# Verify the binary works
RUN ./velo/api/velo-route-server --help || true

# =============================================================================
# Runtime stage (distroless)
# =============================================================================
FROM gcr.io/distroless/cc-debian12:nonroot

LABEL org.opencontainers.image.title="OTTO Velo Route Server"
LABEL org.opencontainers.image.description="OSM routing engine with Dijkstra, A*, bidirectional search"
LABEL org.opencontainers.image.source="https://github.com/ottofleet/otto"
LABEL org.opencontainers.image.documentation="https://github.com/ottofleet/otto/blob/main/velo/CLAUDE.md"

WORKDIR /app

COPY --from=builder --chown=nonroot:nonroot /build/velo/api/velo-route-server /app/velo-route-server

EXPOSE 8082

USER nonroot

ENTRYPOINT ["/app/velo-route-server", "-p", "8082"]
CMD ["/data/map.osm.pbf"]
