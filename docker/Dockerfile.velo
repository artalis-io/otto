# Velo Route Server Dockerfile
#
# Build:
#   docker build -f docker/Dockerfile.velo -t velo-route-server .
#
# Run:
#   docker run -p 8082:8082 -v $(pwd)/data:/data velo-route-server /data/hungary-latest.osm.pbf
#

FROM debian:bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy source files
COPY velo/ velo/
COPY shared/ shared/
COPY vendor/ vendor/
COPY Makefile .

# Build velo library and API
RUN make velo && make velo-api

# Runtime image
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary
COPY --from=builder /build/velo/api/velo-route-server /app/velo-route-server

# Create data directory
RUN mkdir -p /data

EXPOSE 8082

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8082/api/v1/health || exit 1

# Entrypoint expects PBF file path as argument
ENTRYPOINT ["/app/velo-route-server", "-p", "8082"]
CMD ["/data/map.osm.pbf"]
