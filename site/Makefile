# OTTO Landing Page
#
# Zero-dependency static site. Just HTML + CSS.

.PHONY: serve clean

# Development server
serve:
	@echo "Serving at http://localhost:8000"
	@python3 -m http.server 8000 || python -m SimpleHTTPServer 8000

# Nothing to build - it's just static HTML
build:
	@echo "Nothing to build. Site is static HTML."

# Nothing to clean
clean:
	@echo "Nothing to clean."
