{
  "name": "carta-maplibre-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone MapLibre GL JS viewer for Carta vector tiles (dispatch plan inspection). Orthogonal to the Carta C core.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "fonts": "node scripts/make-glyphs.mjs",
    "plan": "node scripts/make-plan.mjs",
    "shot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "fontnik": "^0.7.7",
    "pbf": "^3.3.0",
    "playwright": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "wawoff2": "^2.0.1"
  }
}
